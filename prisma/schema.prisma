// This is your Prisma schema file,
// learn more about it: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int        @id @default(autoincrement())
  nome        String
  nip         String     @unique @db.VarChar(8)
  email       String     @unique
  idade       Int
  senhaHash   String
  ativo       Boolean    @default(true)
  roleId      Int
  role        Role       @relation(fields: [roleId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  auditorias  AuditLog[]

  @@index([roleId])
  @@index([ativo])
}

model Role {
  id          Int              @id @default(autoincrement())
  nome        String           @unique
  descricao   String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          Int              @id @default(autoincrement())
  chave       String           @unique
  descricao   String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Pergunta {
  id              Int      @id @default(autoincrement())
  assunto         String
  tipo            String
  enunciado       String   @db.Text
  respostaCorreta String
  explicacao      String   @db.Text
  criadaEm        DateTime @default(now())

  alternativas Alternativa[]
  partidas     PartidaPergunta[]
  respostas    PartidaResposta[]

  @@index([assunto])
  @@index([tipo])
}

model Alternativa {
  id         Int      @id @default(autoincrement())
  texto      String
  perguntaId Int
  pergunta   Pergunta @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
}

model Partida {
  id                    String   @id @default(uuid())
  nome                  String
  equipe1               String
  equipe2               String
  status                String
  perguntas             Int
  perguntaAtual         Int      @default(0)
  pontuacaoEquipeA      Int      @default(0)
  pontuacaoEquipeB      Int      @default(0)
  tempoResposta         Int      @default(30)
  embaralharPerguntas   Boolean  @default(false)
  mostrarExplicacao     Boolean  @default(true)
  permitirPular         Boolean  @default(true)
  equipeDaVez           String   @default("A")
  tempoRestante         Int      @default(30)
  cronometroFimEm      DateTime?
  respostaVisivel       Boolean  @default(false)
  resultadoPergunta     String?
  data                  DateTime
  criadaEm              DateTime @default(now())
  atualizadaEm          DateTime @updatedAt

  perguntasSelecionadas PartidaPergunta[]
  respostas              PartidaResposta[]

  @@index([status])
  @@index([data])
}

model PartidaPergunta {
  partidaId  String
  perguntaId Int
  ordem      Int

  partida  Partida  @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  pergunta Pergunta @relation(fields: [perguntaId], references: [id], onDelete: Restrict)

  @@id([partidaId, perguntaId])
  @@unique([partidaId, ordem])
  @@index([perguntaId])
}

model PartidaResposta {
  id           Int      @id @default(autoincrement())
  partidaId    String
  perguntaId   Int
  equipe       String
  resultado    String
  resposta     String?
  pontos       Int      @default(0)
  respondidaEm DateTime @default(now())

  partida  Partida  @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  pergunta Pergunta @relation(fields: [perguntaId], references: [id], onDelete: Restrict)

  @@unique([partidaId, perguntaId])
  @@index([partidaId])
  @@index([perguntaId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  usuarioId  Int?
  acao       String
  entidade   String
  entidadeId String?
  descricao  String   @db.Text
  detalhes   String?  @db.Text
  criadoEm   DateTime @default(now())

  usuario User? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([acao])
  @@index([entidade])
  @@index([criadoEm])
}
